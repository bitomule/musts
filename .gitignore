# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Editors
.vscode/
.idea/
*.swp
*.swo
*~
.zed/

# Agent scratch space (git worktrees, plans, transient state).
# Never validated, never committed.
.claude/

# Musts runtime artifacts (anywhere a `.musts/` workspace lives —
# the repo root, the fixture, future sub-workspaces).
**/.musts/cache/
**/.musts/state.sqlite
**/.musts/state.sqlite-shm
**/.musts/state.sqlite-wal
**/.musts/evidence/
**/.musts/.lock

# Fixture-installed extension symlinks (created by the README walkthrough)
fixtures/*/.musts/extensions/*/bazel-extension
fixtures/*/.musts/extensions/*/mav-extension
fixtures/*/.musts/extensions/*/stub-extension

# Self-validation extension symlinks at the repo root
.musts/extensions/cargo/cargo-extension

# The root `ledger.lock.yaml` is committed (it carries the team's
# validated state across clones). The fixture's lock is not — the
# canonical walkthrough must start with nothing validated.
fixtures/*/.musts/ledger.lock.yaml

# The fixture is a self-contained musts workspace (it has its own
# .musts/extensions/ for bazel/build + mav/expect). Hide its
# MUSTS.yml files from the parent walker so root-level
# `musts validate` doesn't try to resolve them with the parent's
# extension index.
fixtures/*/MUSTS.yml
fixtures/*/**/MUSTS.yml

# Test scratch space
/e2e-output/
/tmp/
*.log

# Coverage
*.profraw
*.profdata
tarpaulin-report.html
